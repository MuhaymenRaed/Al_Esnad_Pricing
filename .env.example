# ─────────────────────────────────────────────────────────────────────────────
# Al-Esnad Pricing — environment variables
# Copy to .env.local for local development. On Netlify, set them under
# Site configuration → Environment variables. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL (Project Settings → API / Data API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Browser-safe key. Use the new publishable key (sb_publishable_…) …
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# … or the legacy anon JWT key (only one of the two is needed).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SERVER ONLY — bypasses Row Level Security. Used exclusively for the Auth
# Admin API (invitations, deactivation bans). Never prefix with NEXT_PUBLIC_.
# Either the legacy service_role JWT or the new secret key (sb_secret_…).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Public origin of the app, used in invitation / password-reset e-mail links.
# On Netlify this falls back to the built-in URL variable when unset.
NEXT_PUBLIC_SITE_URL=https://pricing.alisnad.iq

# Brevo SMTP credentials are NOT app variables: they are entered in the
# Supabase dashboard (Authentication → Emails → SMTP Settings). See
# docs/DEPLOYMENT.md §4.
