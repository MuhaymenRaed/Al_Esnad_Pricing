# ─────────────────────────────────────────────────────────────────────────────
# Al-Esnad Pricing — environment variables
# Copy to .env.local for local development. On Netlify, set them under
# Site configuration → Environment variables. NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL (Project Settings → API / Data API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Browser-safe key. Use the new publishable key (sb_publishable_…) …
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# … or the legacy anon JWT key (only one of the two is needed).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SERVER ONLY — bypasses Row Level Security. Used exclusively for the Auth
# Admin API (invitations, deactivation bans). Never prefix with NEXT_PUBLIC_.
# Either the legacy service_role JWT or the new secret key (sb_secret_…).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Public origin of the app, used in invitation / password-reset e-mail links.
# On Netlify this falls back to the built-in URL variable when unset.
NEXT_PUBLIC_SITE_URL=https://pricing.alisnad.iq

# Brevo SMTP credentials are NOT app variables: they are entered in the
# Supabase dashboard (Authentication → Emails → SMTP Settings). See
# docs/DEPLOYMENT.md §4.

# ─── ERPNext & alisnad.iq (SERVER ONLY — never prefix with NEXT_PUBLIC_) ───────
# Prices reach these systems ONLY when an administrator presses "Publish" and
# confirms the review; "Import from ERPNext" reads device items from ERPNext.
# alisnad.iq website database (its own Supabase project): URL + service-role key.
ALISNAD_SUPABASE_URL=https://your-alisnad-project.supabase.co
ALISNAD_SUPABASE_SERVICE_ROLE_KEY=your-alisnad-service-role-key
# ERPNext: site URL and the API key/secret of a user who may read Item and edit Item Price.
ERPNEXT_URL=https://erp.your-company.com
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# Price list that receives the final SELLING price on Publish. Items are created in
# ERPNext with their purchase price here; the import reads it until a device is published.
ERPNEXT_SELLING_PRICE_LIST=الاسناد
# Price list that receives the PURCHASE price on Publish (must differ from the selling
# list: ERPNext keeps one general price per item and list). Imports prefer it.
ERPNEXT_BUYING_PRICE_LIST=Standard Buying
# The ONLY company whose Items are read, imported, linked or priced (ERPNext is shared
# with other companies; their Items are never visible). Required: without it ERPNext is off.
ERPNEXT_COMPANY=الاسناد
# Item groups (comma separated) whose Items are devices, for "Import from ERPNext".
ERPNEXT_ITEM_GROUPS=الأجهزة
